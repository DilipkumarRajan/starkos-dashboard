# .streamlit/secrets.toml
# Used by Streamlit Cloud — paste this into the Secrets UI, do NOT commit this file

[snowflake]
account            = "your_account_identifier"
user               = "CLAUDE_SERVICE_USER"
private_key_path   = ""          # leave blank on Streamlit Cloud
private_key_str    = ""          # paste the full PEM content here for cloud deployments
private_key_passphrase = ""
database           = "PIPE_DATABASE"
warehouse          = "SNOWFLAKE_LEARNING_WH"
role               = ""
